# Google Places API (New) key for the venue lookup. Leave it empty to run without the lookup.
GOOGLE_PLACES_API_KEY=

MONGODB_URL=mongodb://dev:dev@127.0.0.1:27017/myapp?authSource=admin

# MIT Touchstone / Petrock OpenID Connect Configuration
# https://petrock.mit.edu/about/
PETROCK_AUTHORITY=https://petrock.mit.edu
PETROCK_REDIRECT_URI=http://127.0.0.1:8080/auth/petrock/callback
PETROCK_CLIENT_ID=
PETROCK_CLIENT_SECRET=
